{
  "manifest_version": 3,
  "name": "知乎总结工作台桥接",
  "version": "0.1.0",
  "description": "在已登录的知乎标签页中采集结构化问题与回答并回传本机工作台。",
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": [
    "https://www.zhihu.com/*",
    "https://zhihu.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "知乎总结工作台桥接",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.zhihu.com/*", "https://zhihu.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
